<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tipsheet.runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/run_due.sh</string>
    </array>
    <!-- Every 15 minutes. run_due.sh decides what, if anything, is due, on Pacific
         time whatever timezone the Mac is in, so nothing here changes when you travel.
         A wake after missed runs fires this once, and the script catches up. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/launchd.runner.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/launchd.runner.err</string>
</dict>
</plist>
